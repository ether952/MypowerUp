<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_pill_grey"
    android:padding="12dp">

    <!-- CABECERA: MyUP + Nombre del Ejercicio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UP"
            android:textColor="#22C55E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_exercise_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Entrenamiento Activo"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="end"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- FILA DE CONTROLES: SERIE, REPES, PESO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <!-- Píldora Serie -->
        <LinearLayout
            android:id="@+id/btn_widget_add_set"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_white_thumb"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Serie "
                android:textColor="#374151"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_set_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/4"
                android:textColor="#111827"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" +"
                android:textColor="#22C55E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="2dp" />
        </LinearLayout>

        <!-- Píldora Repes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_white_thumb"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center">

            <TextView
                android:id="@+id/btn_widget_reps_minus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#22C55E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingEnd="4dp" />

            <TextView
                android:id="@+id/tv_widget_reps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10r"
                android:textColor="#111827"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_reps_plus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#22C55E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="4dp" />
        </LinearLayout>

        <!-- Píldora Peso -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_white_thumb"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center">

            <TextView
                android:id="@+id/btn_widget_weight_minus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#22C55E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingEnd="4dp" />

            <TextView
                android:id="@+id/tv_widget_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8kg"
                android:textColor="#111827"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_weight_plus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#22C55E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- PIE: Descanso o Estado + Botón Abrir / Terminar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_widget_rest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏱ Descanso: 45s"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Toca '+' para registrar serie"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_widget_finish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TERMINAR"
            android:textColor="#22C55E"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_finish"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

</LinearLayout>
