# Configuración de Firebase para MyPowerUp
# Reemplaza los valores con los que te da Firebase Console -> Configuración del proyecto -> Tus apps (Web </>):

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=mypowerup-XXXXX.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mypowerup-XXXXX
VITE_FIREBASE_STORAGE_BUCKET=mypowerup-XXXXX.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
